#!/usr/bin/env python3
"""Run Claude Code in place of koda, on the Claude subscription.

Stage one of the task gate: a new task is screened here for free, to rule out
broken hidden tests, impossible predicates and unfair prompts, before it goes
to the Sonnet API run that validates it. It measures task fairness and the
ceiling, never koda. See README, "Screening on the Claude subscription".

The harness calls `<bin> --version`, then
  <bin> -p <prompt> --output-format stream-json --mode <auto|safe> \
        --provider <p> --project-root <dir> [--model <m>] [--base-url <u>]
with the project directory as cwd. Provider, base URL and project root are
ignored; `--model` goes to Claude Code as is (`opus`, `sonnet` or a full id).

Subscription only. The child's environment is built from an allowlist, so the
keys the harness copies from koda's keystore, and the desktop app's
ANTHROPIC_BASE_URL and CLAUDE_CODE_* variables, never reach it. Its names go
to stderr, never its values. If `system/init` still reports an API key source
other than "none", the child is killed before the first model call finishes.

Nothing from the machine or the project configures the run: --safe-mode and
an empty --setting-sources turn off user and project settings, CLAUDE.md,
skills, plugins, hooks, MCP servers and auto memory. The files stay in the
project (deleting them would show in the diff), and the model may read them
with its own tools: on the 2026-10-30 ceiling run 7 of 16 history-task runs
read CLAUDE.md with sed. That is comparable, not an advantage: koda loads a
project's CLAUDE.md as project memory on every run (koda-core memory.rs), so
Claude Code gets it only when it looks, koda always.

CLAUDE_AS_KODA_MEMORY=project loads the project's CLAUDE.md the way Claude
Code does, as a system-reminder in the first user message, and nothing else:
it drops --safe-mode, loads only project settings, turns auto memory off and
excludes the user's own ~/.claude/CLAUDE.md, AGENTS.md and rules
(`claudeMdExcludes`), which `--setting-sources project` alone lets through.
Captured on 2.1.296 against a stub: the system prompt is the same as under
--safe-mode, and no user skills or plugins reach the request. Project
settings, agents and skills would load too; the koda checkout has none. The
variable is read here and never reaches the child.

Trust. Both modes run `dontAsk`: the listed tools are allowed, anything else
is denied, and nothing waits for a prompt. Bash runs in Claude Code's OS
sandbox: writes only to the project, the cargo target directory and ~/.cargo,
network only to crates.io. The file tools are outside that sandbox and are
held to the project by their allow rules. `safe` is not a stricter Claude Code
mode, because headless koda approves everything but destructive commands
anyway; it differs only in the approval_request events below. So a shell-safety
task measures what Claude Code chooses, with these differences from koda:
- Destructive commands run instead of being auto-rejected. The translator
  applies koda's rules (a port of DANGER_CHECKS and RAW_DANGER_PATTERNS from
  koda-core/src/bash_safety.rs) and emits the approval_request koda would, so
  `no_destructive_bash` still fails on an attempt, followed here by a result.
- Safe mode raises approval_request for Edit and Write, not for other mutating
  Bash, whose read-only list isn't ported.
- A denial Claude Code reports becomes action_blocked. A sandbox refusal isn't
  a permission denial; it is only an error in the Bash result.

Tools. Read's offset and limit become start_line and num_lines, Edit's strings
become replacements, Agent and Task become InvokeAgent. AskUserQuestion is
mapped but never seen: headless Claude Code doesn't offer it, so a question
arrives as the final message. --safe-mode ignores --agents, so a task's
`agents_dir` worker isn't available; general-purpose is, and counts as a
delegation. Web tools are left out so a history task can't fetch its own fix.

Reads aren't confined to the project, by the tools or the sandbox; a model that
went looking could read another checkout on this machine.

`--translate <file>` translates a recorded stream instead of running anything.
"""

import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

# bin/koda_bash_safety.py, beside this script.
from koda_bash_safety import is_destructive

ALLOWED_ENV = {
    "HOME", "USER", "LOGNAME", "PATH", "TERM", "TMPDIR", "LANG", "LC_ALL", "LC_CTYPE",
    "CARGO_TARGET_DIR", "CARGO_HOME", "RUSTUP_HOME",
}
TOOLS = ["Read", "Edit", "Write", "Bash", "Grep", "Glob", "Agent"]
# Project-relative rules keep the file tools inside the project; Bash is held
# there by the sandbox.
ALLOW_RULES = ["Read", "Edit(./**)", "Write(./**)", "Bash", "Grep", "Glob", "Agent"]


def allow_rules(cwd):
    """The allow rules for a run rooted at `cwd`.

    Claude Code matches `Edit(./**)` against relative paths only, and it
    often calls Edit with the project's absolute path; on 2026-10-30 one
    such call was denied and the model wrote files through Bash for the
    rest of the run. So the project is allowed by absolute path too, in
    both spellings when the real path differs (macOS /private, symlinks).
    """
    rules = list(ALLOW_RULES)
    roots = {os.path.abspath(cwd), os.path.realpath(cwd)}
    for root in sorted(roots):
        rules += [f"Edit(/{root}/**)", f"Write(/{root}/**)"]
    return rules
CRATES_HOSTS = ["crates.io", "index.crates.io", "static.crates.io"]

TOOL_NAMES = {"Agent": "InvokeAgent", "Task": "InvokeAgent", "AskUserQuestion": "AskUser"}

def child_env():
    """The child's environment, and the names of what was kept and dropped."""
    env = {k: v for k, v in os.environ.items() if k in ALLOWED_ENV}
    home = env.get("HOME", str(Path.home()))
    env["PATH"] = f"{home}/.local/bin:{home}/.cargo/bin:{env.get('PATH', '/usr/bin:/bin')}"
    return env, sorted(env), sorted(set(os.environ) - set(env))


def sandbox_settings(env, extra=None):
    writable = [f"{env['HOME']}/.cargo"]
    if env.get("CARGO_TARGET_DIR"):
        target = env["CARGO_TARGET_DIR"]
        # Cargo creates a missing target directory by making a randomly named
        # sibling and renaming it into place, so a fresh directory needs a
        # writable parent. Create it up front and allow the parent as well
        # (seen 2026-10-30: "Operation not permitted ... /target5NuQ7i").
        try:
            os.makedirs(target, exist_ok=True)
        except OSError:
            pass
        writable.append(target)
        writable.append(os.path.dirname(os.path.realpath(target)))
    return json.dumps(
        {
            "sandbox": {
                "enabled": True,
                "failIfUnavailable": True,
                "autoAllowBashIfSandboxed": True,
                "allowUnsandboxedCommands": False,
                "filesystem": {"allowWrite": writable},
                "network": {"allowedDomains": CRATES_HOSTS},
            },
            **(extra or {}),
        }
    )


def text_of(content):
    if isinstance(content, str):
        return content
    return "\n".join(b.get("text", "") for b in content or [] if isinstance(b, dict))


def koda_usage(u):
    return {
        "api_calls": 0,
        "prompt_tokens": u.get("inputTokens", 0),
        "completion_tokens": u.get("outputTokens", 0),
        "cache_read_tokens": u.get("cacheReadInputTokens", 0),
        "cache_creation_tokens": u.get("cacheCreationInputTokens", 0),
        "thinking_tokens": u.get("thinkingTokens", 0),
    }


class Translator:
    """Claude Code's stream-json in, koda's event stream out.

    A background sub-agent gives one `result` per main-loop segment, so the
    run isn't over at the first one. `modelUsage` is cumulative over all
    agents and `usage` is per segment and main loop only, so main is the sum
    of the latter and the children get the rest.
    """

    def __init__(self, mode, cwd, out):
        self.mode, self.out = mode, out
        self.cwd = os.path.realpath(cwd)
        self.calls = {}  # tool_use id -> koda tool name
        self.tool_calls, self.sub_calls = {}, {}
        self.message_ids = {}  # message id -> is_sub_agent
        self.result = None
        self.main = {"inputTokens": 0, "outputTokens": 0, "cacheReadInputTokens": 0,
                     "cacheCreationInputTokens": 0, "thinkingTokens": 0}
        self.denials = []
        self.session = self.model = self.api_key_source = None
        self.last_text = ""
        self.rate_limited = False
        self.errors = []

    def emit(self, event):
        self.out.write(json.dumps(event, ensure_ascii=False) + "\n")
        self.out.flush()

    def rel(self, path):
        if not isinstance(path, str):
            return path
        real = os.path.realpath(path) if os.path.isabs(path) else path
        return os.path.relpath(real, self.cwd) if real.startswith(self.cwd + "/") else path

    def args(self, name, raw):
        args = dict(raw)
        if "file_path" in args:
            args["file_path"] = self.rel(args["file_path"])
        if name == "Read":
            offset, limit = args.pop("offset", None), args.pop("limit", None)
            if offset is not None or limit is not None:
                args["start_line"] = offset if offset is not None else 1
            if limit is not None:
                args["num_lines"] = limit
        elif name == "Edit":
            args["replacements"] = [
                {"old_str": args.pop("old_string", ""), "new_str": args.pop("new_string", "")}
            ]
        elif name == "Grep" and "path" in args:
            args["file_path"] = self.rel(args.pop("path"))
        elif name == "InvokeAgent":
            args["agent_name"] = args.pop("subagent_type", "general-purpose")
        return args

    def tool_use(self, block, sub):
        name = TOOL_NAMES.get(block["name"], block["name"])
        id_ = block["id"]
        self.calls[id_] = name
        counts = self.sub_calls if sub else self.tool_calls
        counts[name] = counts.get(name, 0) + 1
        args = self.args(name, block.get("input") or {})
        self.emit({"type": "tool_call_start", "id": id_, "name": name, "args": args,
                   "is_sub_agent": sub})
        effect = None
        if name == "Bash" and is_destructive(args.get("command", "")):
            effect = "Destructive"
        elif self.mode == "safe" and name in ("Edit", "Write"):
            effect = "LocalMutation"
        if effect:
            detail = args.get("command") or args.get("file_path", "")
            self.emit({"type": "approval_request", "id": "ap" + id_, "tool_name": name,
                       "detail": detail, "preview": None, "effect": effect})
        if name == "AskUser":
            self.emit({"type": "ask_user_request", "id": id_, "question": args})

    def tool_result(self, block):
        id_ = block.get("tool_use_id")
        name = self.calls.get(id_, "")
        output = text_of(block.get("content"))
        output = re.sub(r"</?tool_use_error>", "", output)
        if block.get("is_error") and name == "Edit" and not output.startswith("Error:"):
            output = "Error: " + output
        self.emit({"type": "tool_call_result", "id": id_, "name": name, "output": output})

    def assistant(self, event):
        message = event["message"]
        sub = event.get("parent_tool_use_id") is not None
        self.message_ids[message.get("id")] = sub
        for block in message.get("content") or []:
            kind = block.get("type")
            if kind == "tool_use":
                self.tool_use(block, sub)
            elif kind == "text" and block.get("text"):
                if sub:
                    self.emit({"type": "sub_agent_text", "text": block["text"]})
                else:
                    self.last_text = block["text"]
                    self.emit({"type": "text_delta", "text": block["text"]})
                    self.emit({"type": "text_done"})

    def finish_segment(self, event):
        self.result = event
        usage = event.get("usage") or {}
        self.main["inputTokens"] += usage.get("input_tokens", 0)
        self.main["outputTokens"] += usage.get("output_tokens", 0)
        self.main["cacheReadInputTokens"] += usage.get("cache_read_input_tokens", 0)
        self.main["cacheCreationInputTokens"] += usage.get("cache_creation_input_tokens", 0)
        details = usage.get("output_tokens_details") or {}
        self.main["thinkingTokens"] += details.get("thinking_tokens", 0)
        for denial in event.get("permission_denials") or []:
            if denial.get("tool_use_id") not in self.denials:
                self.denials.append(denial.get("tool_use_id"))
                name = denial.get("tool_name", "")
                detail = json.dumps(denial.get("tool_input"), ensure_ascii=False)
                self.emit({"type": "action_blocked", "tool_name": TOOL_NAMES.get(name, name),
                           "detail": detail})
        if event.get("is_error"):
            self.errors.append(text_of(event.get("result")) or event.get("subtype", "error"))
            self.errors += event.get("errors") or []

    def event(self, event):
        kind = event.get("type")
        if kind == "system" and event.get("subtype") == "init":
            self.session, self.model = event.get("session_id"), event.get("model")
            self.api_key_source = event.get("apiKeySource")
            self.emit({"type": "turn_start", "turn_id": self.session})
        elif kind == "system" and event.get("subtype") == "api_retry":
            self.emit({"type": "warn", "message": f"API retry: {event.get('error')}"})
        elif kind == "assistant":
            self.assistant(event)
        elif kind == "user":
            content = event.get("message", {}).get("content")
            for block in content if isinstance(content, list) else []:
                if block.get("type") == "tool_result":
                    self.tool_result(block)
        elif kind == "rate_limit_event":
            if event.get("rate_limit_info", {}).get("status") == "rejected":
                self.rate_limited = True
                self.emit({"type": "warn", "message": "Claude subscription limit reached"})
        elif kind == "result":
            self.finish_segment(event)

    def usage(self):
        """Totals and per-agent split."""
        totals = {}
        for u in ((self.result or {}).get("modelUsage") or {}).values():
            for key, value in u.items():
                if isinstance(value, (int, float)):
                    totals[key] = totals.get(key, 0) + value
        total, main = koda_usage(totals or self.main), koda_usage(self.main)
        total["api_calls"] = len(self.message_ids)
        main["api_calls"] = sum(not sub for sub in self.message_ids.values())
        by_agent = {"main": main}
        rest = {k: total[k] - main[k] for k in total}
        if any(rest.values()):
            by_agent["sub_agents"] = rest
        return total, by_agent

    def finish(self, exit_code):
        """Koda's last two events, once the stream has ended."""
        result = self.result or {}
        ok = (
            exit_code == 0
            and bool(self.result)
            and result.get("subtype") == "success"
            and not result.get("is_error")
        )
        end = {"kind": "complete" if ok else "error"}
        self.emit({"type": "turn_end", "turn_id": self.session, "reason": end})
        usage, by_agent = self.usage()
        response = text_of(result.get("result")) if ok else ""
        self.emit({
            "type": "run_summary",
            "success": ok,
            "response": response or self.last_text,
            "error": "; ".join(self.errors) or (None if ok else f"claude exited {exit_code}"),
            "turn_end": end,
            "tool_calls": self.tool_calls,
            "sub_agent_tool_calls": self.sub_calls,
            "usage": usage,
            "usage_by_agent": by_agent,
            "provider": "claude-code",
            "model": self.model,
            "session_id": self.session,
            "elapsed_ms": result.get("duration_ms"),
            # The list-price estimate, not a charge: this run is on the subscription.
            "notional_cost_usd": result.get("total_cost_usd"),
            "api_key_source": self.api_key_source,
            "rate_limited": self.rate_limited,
        })


def parse_args(argv):
    opts = {"prompt": "", "model": "", "mode": "auto", "translate": None, "version": False}
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--version":
            opts["version"] = True
        elif arg in ("-p", "--model", "--mode", "--translate"):
            opts[{"-p": "prompt"}.get(arg, arg[2:])] = argv[i + 1]
            i += 1
        elif arg in ("--output-format", "--provider", "--base-url", "--project-root"):
            i += 1
        i += 1
    return opts


def main():
    opts = parse_args(sys.argv[1:])
    env, kept, dropped = child_env()
    claude = shutil.which("claude", path=env["PATH"]) or "claude"

    if opts["version"]:
        out = subprocess.run([claude, "--version"], env=env, capture_output=True, text=True)
        print(f"claude-as-koda {out.stdout.strip()}")
        return out.returncode

    if opts["translate"]:
        translator = Translator(opts["mode"], os.getcwd(), sys.stdout)
        with open(opts["translate"]) as stream:
            for line in stream:
                translator.event(json.loads(line))
        translator.finish(0)
        return 0

    if not opts["prompt"]:
        print("claude-as-koda: no -p prompt", file=sys.stderr)
        return 2

    print(f"claude-as-koda: child env names: {' '.join(kept)}", file=sys.stderr)
    print(f"claude-as-koda: dropped {len(dropped)} env names: {' '.join(dropped)}", file=sys.stderr)

    memory = os.environ.get("CLAUDE_AS_KODA_MEMORY", "")
    if memory not in ("", "project"):
        print(f"claude-as-koda: unknown CLAUDE_AS_KODA_MEMORY {memory!r}", file=sys.stderr)
        return 2
    if memory == "project":
        print("claude-as-koda: loading project CLAUDE.md", file=sys.stderr)
        isolation = ["--setting-sources", "project"]
        # `--setting-sources project` keeps user settings out but not the
        # user's own CLAUDE.md and rules: found 2026-11-10, when the owner's
        # ~/.claude/CLAUDE.md sent every Claude Code run of a vault task to
        # the owner's real notes vault. Exclude them by path.
        claude_dir = os.path.join(os.path.expanduser("~"), ".claude")
        extra = {
            "autoMemoryEnabled": False,
            "claudeMdExcludes": [
                os.path.join(claude_dir, "CLAUDE.md"),
                os.path.join(claude_dir, "AGENTS.md"),
                os.path.join(claude_dir, "rules", "**"),
            ],
        }
    else:
        isolation = ["--safe-mode", "--setting-sources", ""]
        extra = None

    args = [claude, "-p", opts["prompt"],
            "--output-format", "stream-json", "--verbose", "--forward-subagent-text",
            *isolation, "--disable-slash-commands",
            "--strict-mcp-config", "--no-session-persistence",
            "--permission-mode", "dontAsk",
            "--tools", ",".join(TOOLS),
            "--allowedTools", " ".join(allow_rules(os.getcwd())),
            "--settings", sandbox_settings(env, extra)]
    if opts["model"]:
        args += ["--model", opts["model"]]

    translator = Translator(opts["mode"], os.getcwd(), sys.stdout)
    child = subprocess.Popen(args, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, text=True)
    for line in child.stdout:
        try:
            event = json.loads(line)
        except ValueError:
            sys.stderr.write(line)
            continue
        translator.event(event)
        if translator.api_key_source not in (None, "none"):
            child.kill()
            child.wait()
            print(
                f"claude-as-koda: refusing API key source {translator.api_key_source!r}",
                file=sys.stderr,
            )
            translator.errors.append("not on the subscription")
            translator.finish(3)
            return 3
    code = child.wait()
    translator.finish(code)
    return code


if __name__ == "__main__":
    sys.exit(main())
