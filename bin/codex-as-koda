#!/bin/zsh
# Run Codex CLI in place of koda, so the harness can grade the same tasks
# with the same local model and engine through a different agent. The
# harness calls `<bin> --version`, then
#   <bin> -p <prompt> --output-format stream-json --mode auto \
#         --provider <p> --project-root <dir> [--model <m>] [--base-url <u>]
# with the project directory as cwd. Everything but the prompt, model and
# base URL is koda-specific and ignored. Codex's `--json` events go to
# stdout, where the harness keeps them as the transcript; there is no
# `run_summary` line, so the report shows pass/fail and wall time only.
#
# Codex runs in its workspace-write sandbox with approvals off, like koda's
# `--mode auto`. The harness points CARGO_TARGET_DIR outside the project,
# so that directory and ~/.cargo are added as writable roots for the build.
#
# Like koda, each run gets a fresh home. CODEX_HOME goes under the run's own
# XDG_CONFIG_HOME, so nothing from ~/.codex reaches it: no config, history,
# memories or global AGENTS.md. The local model needs no login. Codex reads
# the project's AGENTS.md, which is where the harness puts a pinned `memory`
# file. Codex has no probe for a local model's window, so the model's
# KODA_MAX_CONTEXT_TOKENS, which pins koda's, becomes its model_context_window.
set -u
export PATH="$HOME/.cargo/bin:$PATH"

prompt="" model="" base_url=""
while [ $# -gt 0 ]; do
  case "$1" in
    --version) codex --version; exit $? ;;
    -p) prompt="$2"; shift 2 ;;
    --model) model="$2"; shift 2 ;;
    --base-url) base_url="$2"; shift 2 ;;
    --output-format|--mode|--provider|--project-root) shift 2 ;;
    *) shift ;;
  esac
done
[ -n "$prompt" ] || { echo "codex-as-koda: no -p prompt" >&2; exit 2; }

if [ -n "${XDG_CONFIG_HOME:-}" ]; then
  export CODEX_HOME="$XDG_CONFIG_HOME/codex"
else
  export CODEX_HOME="$(mktemp -d)/codex"
fi
mkdir -p "$CODEX_HOME"
echo "codex-as-koda: CODEX_HOME=$CODEX_HOME" >&2

# Codex's lmstudio provider reads its base URL from CODEX_OSS_BASE_URL.
if [ -n "$base_url" ]; then export CODEX_OSS_BASE_URL="$base_url"; fi
roots="\"$HOME/.cargo\""
if [ -n "${CARGO_TARGET_DIR:-}" ]; then roots="$roots, \"$CARGO_TARGET_DIR\""; fi
args=(exec --oss --local-provider lmstudio --json --skip-git-repo-check
      -s workspace-write -c approval_policy=never
      -c "sandbox_workspace_write.writable_roots=[$roots]"
      -C "$PWD")
if [ -n "$model" ]; then args+=(-m "$model"); fi
window="${KODA_MAX_CONTEXT_TOKENS:-}"
if [ -n "$window" ]; then
  case "$window" in
    *[!0-9]*) echo "codex-as-koda: KODA_MAX_CONTEXT_TOKENS=$window is not a number" >&2; exit 2 ;;
  esac
  args+=(-c "model_context_window=$window")
fi
exec codex "${args[@]}" "$prompt"
