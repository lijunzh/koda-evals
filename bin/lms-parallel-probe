#!/usr/bin/env python3
"""Does a local server get more done with concurrent requests?

Talks to an OpenAI-compatible server directly, with no koda and no tasks, so
it measures the engine alone. At each concurrency it sends that many requests
at once, for a few rounds, and prints total generation speed and how each
request fared, relative to one at a time. That answers whether `--jobs` above
1 can pay before spending hours on a run that shows it can't.

Two prompt sizes, because they fail differently. Short prompts show how the
GPU shares out. Long ones show whether the slots share one context cache:
LM Studio's log says `kv_unified = 'true'`, so four 40K prompts may not fit in
a 131K cache even though each one fits a slot. If they don't, the long case
slows down badly or errors, and LM Studio's log shows it.

Every request starts with its own random line, so the prompt cache can't
flatter a result.

  lms load ornith-1.5-35b-a3b --identifier ornith -c 131072 --parallel 4 -y
  bin/lms-parallel-probe --model ornith --out results/parallel-probe.jsonl
  lms unload ornith

The bar: total speed at 2 must be at least 1.3 times the speed at 1 on short
prompts, or parallel eval jobs can't pay. It needs the GPU to itself, so it
refuses to start while `koda-eval run` is running, and it refuses a model that
isn't loaded, because LM Studio would otherwise load one on demand.
"""
import argparse
import json
import statistics
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
import uuid

CHARS_PER_TOKEN = 4
WORDS = "alpha bravo charlie delta echo foxtrot golf hotel india juliet kilo lima".split()
BAR = 1.3


def prompt_of(tokens):
    """About `tokens` tokens of filler under a unique first line."""
    filler = []
    size = 0
    while size < tokens * CHARS_PER_TOKEN:
        word = WORDS[len(filler) % len(WORDS)]
        filler.append(word)
        size += len(word) + 1
    return (
        f"Request {uuid.uuid4()}.\n"
        + " ".join(filler)
        + "\n\nIgnore the text above. Count upward from 1, one number per line, "
        "and don't stop."
    )


def call(base_url, model, tokens, max_tokens, timeout):
    """One streamed request: its timings, token counts and any failure."""
    body = {
        "model": model,
        "messages": [{"role": "user", "content": prompt_of(tokens)}],
        "max_tokens": max_tokens,
        "temperature": 0,
        "stream": True,
        "stream_options": {"include_usage": True},
    }
    request = urllib.request.Request(
        f"{base_url.rstrip('/')}/chat/completions",
        data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json"},
    )
    row = {"tokens_asked": tokens, "prompt_tokens": 0, "completion_tokens": 0}
    row["finish_reason"] = row["error"] = row["first_token_s"] = None
    started = time.monotonic()
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            for line in response:
                line = line.decode("utf-8", "replace").strip()
                if not line.startswith("data:") or line.endswith("[DONE]"):
                    continue
                chunk = json.loads(line[len("data:") :])
                # LM Studio reports a failure inside a 200 stream, such as
                # "Context size has been exceeded" when slots overflow the
                # shared cache, so the HTTP status alone misses it.
                if chunk.get("error"):
                    error = chunk["error"]
                    row["error"] = error.get("message", str(error)) if isinstance(error, dict) else str(error)
                    break
                usage = chunk.get("usage")
                if usage:
                    row["prompt_tokens"] = usage.get("prompt_tokens", 0)
                    row["completion_tokens"] = usage.get("completion_tokens", 0)
                for choice in chunk.get("choices") or []:
                    if row["first_token_s"] is None and (choice.get("delta") or {}).get("content"):
                        row["first_token_s"] = time.monotonic() - started
                    if choice.get("finish_reason"):
                        row["finish_reason"] = choice["finish_reason"]
    except (OSError, ValueError, urllib.error.HTTPError) as err:
        row["error"] = f"{type(err).__name__}: {err}"
    if row["error"] is None and row["finish_reason"] is None:
        row["error"] = "stream ended without a finish reason"
    row["elapsed_s"] = time.monotonic() - started
    return row


def batch(base_url, model, tokens, concurrency, max_tokens, timeout):
    """`concurrency` requests at once; the wall time covers all of them."""
    rows = [None] * concurrency

    def one(i):
        rows[i] = call(base_url, model, tokens, max_tokens, timeout)

    threads = [threading.Thread(target=one, args=(i,)) for i in range(concurrency)]
    started = time.monotonic()
    for thread in threads:
        thread.start()
    for thread in threads:
        thread.join()
    return rows, time.monotonic() - started


def summarize(concurrency, tokens, rounds):
    """One line of the table from every round at this concurrency and size."""
    rows = [row for batch_rows, _ in rounds for row in batch_rows]
    wall = sum(seconds for _, seconds in rounds)
    first = [row["first_token_s"] for row in rows if row["first_token_s"] is not None]
    return {
        "tokens": tokens,
        "concurrency": concurrency,
        "requests": len(rows),
        "errors": sum(1 for row in rows if row["error"]),
        "tok_s": sum(row["completion_tokens"] for row in rows) / wall if wall else 0.0,
        "median_elapsed_s": statistics.median(row["elapsed_s"] for row in rows),
        "median_first_token_s": statistics.median(first) if first else None,
        "wall_s": wall,
    }


def print_table(lines):
    print("| prompt | at once | tok/s | vs 1 | median request | median first token | errors |")
    print("|---|---|---|---|---|---|---|")
    for line in lines:
        base = next(
            (o["tok_s"] for o in lines if o["tokens"] == line["tokens"] and o["concurrency"] == 1),
            0.0,
        )
        ratio = f"{line['tok_s'] / base:.2f}x" if base else "-"
        first = line["median_first_token_s"]
        first = f"{first:.1f}s" if first is not None else "-"
        print(
            f"| {line['tokens']} | {line['concurrency']} | {line['tok_s']:.1f} | {ratio} "
            f"| {line['median_elapsed_s']:.1f}s | {first} | {line['errors']}/{line['requests']} |"
        )


def verdict(lines):
    """Whether the smallest prompt size clears the bar at concurrency 2."""
    if not lines:
        return "no results"
    smallest = min(line["tokens"] for line in lines)
    speed = {line["concurrency"]: line for line in lines if line["tokens"] == smallest}
    if 1 not in speed or 2 not in speed or not speed[1]["tok_s"]:
        return "needs concurrency 1 and 2 to compare"
    ratio = speed[2]["tok_s"] / speed[1]["tok_s"]
    outcome = "clears" if ratio >= BAR and not speed[2]["errors"] else "misses"
    return f"{smallest}-token prompts at 2: {ratio:.2f}x, {outcome} the {BAR}x bar"


def refuse_reason(base_url, model):
    """Why this must not start, if anything."""
    busy = subprocess.run(["pgrep", "-f", "koda-eval run"], capture_output=True, text=True)
    if busy.stdout.strip():
        return "koda-eval run is running, and this would disturb it"
    url = base_url.rstrip("/").removesuffix("/v1") + "/api/v0/models"
    try:
        with urllib.request.urlopen(url, timeout=5) as response:
            models = json.load(response).get("data", [])
    except (OSError, ValueError) as err:
        return f"can't read loaded models from {url}: {err}"
    if not any(m.get("id") == model and m.get("state") == "loaded" for m in models):
        return f"{model} isn't loaded, and the server would load it on demand"
    return None


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--base-url", default="http://localhost:1234/v1")
    parser.add_argument("--model", required=True)
    parser.add_argument("--levels", default="1,2,3,4", help="concurrency levels")
    parser.add_argument("--sizes", default="5000,40000", help="prompt sizes in tokens")
    parser.add_argument("--rounds", type=int, default=3, help="batches at each level")
    parser.add_argument("--max-tokens", type=int, default=256)
    parser.add_argument("--timeout", type=float, default=600, help="seconds per request")
    parser.add_argument("--out", help="also write every request to this JSONL file")
    parser.add_argument(
        "--skip-checks",
        action="store_true",
        help="skip the busy and loaded-model checks, for a stub server",
    )
    args = parser.parse_args()

    if not args.skip_checks:
        reason = refuse_reason(args.base_url, args.model)
        if reason:
            sys.exit(f"lms-parallel-probe: not starting: {reason}")

    levels = [int(n) for n in args.levels.split(",")]
    sizes = [int(n) for n in args.sizes.split(",")]
    out = open(args.out, "a", encoding="utf-8") if args.out else None
    lines = []
    for tokens in sizes:
        for concurrency in levels:
            rounds = []
            for number in range(1, args.rounds + 1):
                print(f"{tokens} tokens, {concurrency} at once, round {number}...", file=sys.stderr)
                rows, seconds = batch(
                    args.base_url, args.model, tokens, concurrency, args.max_tokens, args.timeout
                )
                rounds.append((rows, seconds))
                if out:
                    for row in rows:
                        record = {"concurrency": concurrency, "round": number, "batch_s": seconds}
                        out.write(json.dumps(record | row) + "\n")
            lines.append(summarize(concurrency, tokens, rounds))
    if out:
        out.close()

    print_table(lines)
    print()
    print(verdict(lines))
    print("Check LM Studio's server log for slot erasure or context shifts in the long case.")


if __name__ == "__main__":
    main()
